# NetTap Environment Configuration
# Copy to .env and modify as needed

# Management interface
MGMT_INTERFACE=eth2
MGMT_IP=192.168.1.100
MGMT_NETMASK=255.255.255.0

# Bridge interfaces
WAN_INTERFACE=eth0
LAN_INTERFACE=eth1

# Dashboard
NETTAP_HOSTNAME=nettap.local
DASHBOARD_PORT=443

# OpenSearch
OPENSEARCH_JAVA_OPTS="-Xms4g -Xmx4g"

# Storage retention (days)
RETENTION_HOT=90
RETENTION_WARM=180
RETENTION_COLD=30
DISK_THRESHOLD_PERCENT=80

# Alerting (optional). The daemon sends alert emails and webhooks (NET-224).
# OLD CODE START — NET-224: nothing read these names; the daemon reads the names below
# SMTP_USER=
# SMTP_PASS=
# OLD CODE END
# The SMTP server. Settings › API keys can set it too, and what is saved there wins. The
# installer copies these into docker/.env, the file compose reads (a value containing a quote
# is skipped: set that one in Settings › API keys).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
# These three fill Settings › Notifications on first start only (while the daemon has no
# notifications.json); after that, change them on that page.
# Comma-separated recipients
ALERT_EMAIL=
# http:// or https:// only
WEBHOOK_URL=
# Lowest severity that notifies: 1 critical, 2 high, 3 medium, 4 low
ALERT_SEVERITY_THRESHOLD=2
