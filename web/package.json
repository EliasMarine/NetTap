{
	"name": "nettap-web",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:visual": "playwright test -c playwright.visual.config.ts",
		"check:colors": "node scripts/check-colors.mjs",
		"check:e2e": "svelte-kit sync && tsc -p e2e/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.53.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.0",
		"jsdom": "^30.1.3",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"three": "^0.186.1",
		"tslib": "^2.7.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"argon2": "^0.41.0",
		"jsonwebtoken": "^9.0.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
