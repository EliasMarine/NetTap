{
	"name": "nettap-web",
	"private": true,
	"license": "GPL-3.0-only",
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:visual": "playwright test -c playwright.visual.config.ts",
		"capture:media": "NETTAP_CAPTURE_MEDIA=1 playwright test -c playwright.visual.config.ts --project=media",
		"check:colors": "node scripts/check-colors.mjs",
		"check:e2e": "svelte-kit sync && tsc -p e2e/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "~3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/jsonwebtoken": "^9.0.0",
		"jsdom": "^25.0.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"three": "^0.187.0",
		"tslib": "^2.7.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"argon2": "^0.41.0",
		"jsonwebtoken": "^9.0.0"
	}
}
