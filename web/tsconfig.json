{
	// OLD CODE: "extends": "./.svelte-kit/tsconfig.json", (kit 3 writes its base config to node_modules/$app/tsconfig.json instead; NET-315)
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	},
	// The same files the kit 2 generated config covered (src and the Vite config); e2e/ has its own tsconfig
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker"]
	// Path aliases are handled by the `alias` option of sveltekit() in vite.config.ts
	// (kit 3 dropped svelte.config.js and $lib; see https://svelte.dev/docs/kit/$lib)
}
