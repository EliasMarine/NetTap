FROM docker:27-cli AS docker-cli
FROM python:3.12-slim-bookworm

# -- Metadata ----------------------------------------------------------------
LABEL maintainer="NetTap Contributors <https://github.com/EliasMarine/NetTap>"
LABEL org.opencontainers.image.title="nettap-storage-daemon"
LABEL org.opencontainers.image.description="NetTap storage & health daemon — rolling retention, SMART monitoring, disk management"
LABEL org.opencontainers.image.source="https://github.com/EliasMarine/NetTap"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Docker CLI for docker exec into sibling containers (TShark)
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

RUN apt-get update && apt-get install -y --no-install-recommends \
    smartmontools \
    ethtool \
    iproute2 \
    util-linux \
    whois \
    dnsutils \
    traceroute \
    iputils-ping \
    openssl \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/nettap/daemon

# Install Python dependencies first (layer caching)
COPY daemon/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY daemon/ .

# Create non-root user (mirrors the web Dockerfile pattern)
RUN groupadd -r nettap && useradd -r -g nettap -s /sbin/nologin nettap
RUN chown -R nettap:nettap /opt/nettap
USER nettap

# Expose the HTTP API port
EXPOSE 8880

# Health check via the daemon's own API
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8880/api/health')" || exit 1

# NOTE: The daemon needs NET_ADMIN for ethtool NIC LED blink and
# SYS_PTRACE for nsenter into host network namespace.  These are
# granted via cap_add in docker-compose.yml alongside cap_drop: ALL.
# The daemon also runs with pid: host for nsenter -t 1 -n access.
CMD ["python3", "main.py"]
